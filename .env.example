# Copia este archivo a ".env" (sin ".example") y completa tus valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

# --- IA (ia-client.js) ---
# Requerido: API key del proveedor de IA activo.
IA_API_KEY=


# Opcional: si no se define, usa Groq (free tier) por defecto.
# Para usar DeepSeek en vez de Groq, descomenta y ajusta estas dos líneas:
# IA_BASE_URL=https://api.deepseek.com
# IA_MODEL=deepseek-chat

# --- Autenticación ---
# Obligatorio si NODE_ENV=production (el servidor no arranca sin esto en producción).
# Si no se define en desarrollo, usa un secreto de desarrollo NO seguro.
# JWT_SECRET=
# NODE_ENV=production

# --- Servidor ---
# Opcional: puerto del backend (por defecto 4000).
# PORT=4000

# --- CORS ---
# Obligatorio en producción: dominios permitidos para llamar a esta API
# desde el navegador (separados por comas, sin espacios extra, con protocolo
# y sin "/" final). En desarrollo no hace falta: ya se permiten los orígenes
# típicos de Vite en localhost automáticamente.
# Ejemplo con un solo dominio:
# CORS_ALLOWED_ORIGINS=https://app.tudominio.com
# Ejemplo con varios (frontend productivo + un preview, por ejemplo):
# CORS_ALLOWED_ORIGINS=https://app.tudominio.com,https://staging.tudominio.com
