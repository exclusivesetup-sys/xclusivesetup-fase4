# =================================================================
# XCLUSIVE SETUP CRM - PLANTILLA DEL PERFIL ACADÉMICO
#
# INSTRUCCIONES:
# 1. Copia este archivo con el nombre ".env.academico":
#    Windows (PowerShell): Copy-Item .env.academico.example .env.academico
#    Linux / macOS:        cp .env.academico.example .env.academico
# 2. Configura obligatoriamente los campos JWT_SECRET y DEMO_ADMIN_PASSWORD
#    antes de ejecutar la siembra (seed) o iniciar el servidor.
# 3. Nunca compartas ni agregues a Git tu archivo ".env.academico" final.
# =================================================================

# --- Parámetros de Entorno y Red (Valores predeterminados académicos) ---
APP_ENV=academico
NODE_ENV=development
PORT=4050
VITE_PORT=5180
VITE_BACKEND_PORT=4050
VITE_APP_ENV=academico
VITE_TOKEN_STORAGE_KEY=xs_academico_token
VITE_API_URL=

# --- Base de Datos Aislada y Almacenamiento Local ---
# El servidor creará la carpeta uploads/academico automáticamente si no existe.
DB_FILE=database.academico.db
UPLOADS_DIR_NAME=uploads/academico

# --- Política de Orígenes Permitidos (CORS) ---
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Deshabilitación de Servicios Externos ---
# En el modo académico, los endpoints de IA responden HTTP 503 controlado para no consumir cuotas externas.
DESHABILITAR_IA=true

# --- Seguridad y Autenticación (OBLIGATORIO CONFIGURAR) ---
# Genera un secreto criptográfico aleatorio y único en tu terminal ejecutando:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Pega el resultado a continuación sin comillas adicionales:
JWT_SECRET=

# --- Usuario Administrador de Demostración (OBLIGATORIO CONFIGURAR) ---
# Correo asignado al usuario administrador demo:
DEMO_ADMIN_EMAIL=demo@example.com

# Asigna una contraseña segura para tu demostración local (mínimo 8 caracteres):
DEMO_ADMIN_PASSWORD=
